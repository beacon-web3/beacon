FRONTEND_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
AUTH_SIGNUP_THROTTLE_RATE=5/min
AUTH_LOGIN_THROTTLE_RATE=10/min
AUTH_PASSWORD_RESET_THROTTLE_RATE=3/min
AUTH_PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/min
AUTH_EMAIL_VERIFICATION_REQUEST_THROTTLE_RATE=3/min
AUTH_EMAIL_VERIFICATION_CONFIRM_THROTTLE_RATE=10/min
AUTH_SOCIAL_START_THROTTLE_RATE=20/min
AUTH_SOCIAL_CALLBACK_THROTTLE_RATE=20/min
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
