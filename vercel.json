{
  "services": {
    "frontend": { "root": "apps/web/" },
    "backend": { "root": "apps/api/", "entrypoint": "beacon_api.wsgi:application" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
